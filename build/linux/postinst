#!/bin/bash
# ClashHelen post-install script
# Tested on Ubuntu 20.04 / 22.04 / 24.04 and Debian derivatives

set -e

APP_DIR='/opt/clash-helen'
BIN='/usr/bin/clash-helen'

# ── 1. Symlink to /usr/bin ─────────────────────────────────────────────────
if type update-alternatives >/dev/null 2>&1; then
    if [ -L "$BIN" ] && [ -e "$BIN" ] && [ "$(readlink "$BIN")" != '/etc/alternatives/clash-helen' ]; then
        rm -f "$BIN"
    fi
    update-alternatives --install "$BIN" 'clash-helen' "$APP_DIR/clash-helen" 100 \
        || ln -sf "$APP_DIR/clash-helen" "$BIN"
else
    ln -sf "$APP_DIR/clash-helen" "$BIN"
fi

# ── 2. Electron sandbox permissions ───────────────────────────────────────
chmod 4755 "$APP_DIR/chrome-sandbox" 2>/dev/null || true

# ── 3. Mihomo core — setuid + executable ──────────────────────────────────
# cap_net_admin,cap_net_bind_service allows TUN without full root
for core in mihomo mihomo-alpha; do
    CORE_PATH="$APP_DIR/resources/sidecar/$core"
    if [ -f "$CORE_PATH" ]; then
        chmod +x "$CORE_PATH"
        # Try setcap first (preferred over setuid — no password popup)
        if command -v setcap >/dev/null 2>&1; then
            setcap cap_net_admin,cap_net_bind_service=+ep "$CORE_PATH" 2>/dev/null || \
                chmod +sx "$CORE_PATH" 2>/dev/null || true
        else
            chmod +sx "$CORE_PATH" 2>/dev/null || true
        fi
    fi
done

# ── 4. polkit rule for TUN (passwordless for sudo group) ──────────────────
PKLA_DIR='/etc/polkit-1/localauthority/50-local.d'
PKLA_SRC="$APP_DIR/resources/clash-helen-tun.pkla"
if [ -d "$PKLA_DIR" ] && [ -f "$PKLA_SRC" ]; then
    cp "$PKLA_SRC" "$PKLA_DIR/clash-helen-tun.pkla"
fi

# ── 5. systemd user service (optional autostart) ──────────────────────────
SYSTEMD_USER_DIR='/etc/xdg/autostart'
DESKTOP_SRC="$APP_DIR/resources/clash-helen.desktop"
if [ -d "$SYSTEMD_USER_DIR" ] && [ -f "$DESKTOP_SRC" ]; then
    cp "$DESKTOP_SRC" "$SYSTEMD_USER_DIR/clash-helen.desktop" 2>/dev/null || true
fi

# ── 6. MIME / desktop database ────────────────────────────────────────────
if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# ── 7. Icon caches ────────────────────────────────────────────────────────
if hash gtk-update-icon-cache 2>/dev/null; then
    for dir in /usr/share/icons/hicolor /usr/share/icons/gnome; do
        [ -d "$dir" ] && gtk-update-icon-cache -f -t "$dir" 2>/dev/null || true
    done
fi

if hash update-icon-caches 2>/dev/null; then
    update-icon-caches /usr/share/icons/* 2>/dev/null || true
fi

echo "ClashHelen installed successfully. Run: clash-helen"
