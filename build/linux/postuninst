#!/bin/bash
# ClashHelen post-uninstall script

case "$1" in
  remove|purge|0)
    # ── Remove symlink ────────────────────────────────────────────────────
    if type update-alternatives >/dev/null 2>&1; then
        update-alternatives --remove 'clash-helen' '/opt/clash-helen/clash-helen' 2>/dev/null || true
    fi
    [ -L '/usr/bin/clash-helen' ] && rm -f '/usr/bin/clash-helen'

    # ── Remove polkit rule ────────────────────────────────────────────────
    rm -f '/etc/polkit-1/localauthority/50-local.d/clash-helen-tun.pkla' 2>/dev/null || true

    # ── Remove autostart entry ────────────────────────────────────────────
    rm -f '/etc/xdg/autostart/clash-helen.desktop' 2>/dev/null || true

    # ── MIME / desktop databases ──────────────────────────────────────────
    if hash update-mime-database 2>/dev/null; then
        update-mime-database /usr/share/mime || true
    fi
    if hash update-desktop-database 2>/dev/null; then
        update-desktop-database /usr/share/applications || true
    fi

    # ── Icon caches ───────────────────────────────────────────────────────
    if hash gtk-update-icon-cache 2>/dev/null; then
        for dir in /usr/share/icons/hicolor /usr/share/icons/gnome; do
            [ -d "$dir" ] && gtk-update-icon-cache -f -t "$dir" 2>/dev/null || true
        done
    fi
    ;;
  *)
    ;;
esac
